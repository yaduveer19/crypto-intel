# Production Environment Variables
# Copy to .env on your server

# LLM API (your agnes-2.0-flash key)
LLM_API_KEY=sk-BP2U8RoftMRtikEphIw2d8QB0PtUYnYmlPhLylvMuVnJVNDf
LLM_API_BASE=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.0-flash

# Database
DATABASE_URL=postgresql://cryptouser:cryptopass@postgres:5432/cryptodb

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Secret — CHANGE THIS to a random string
